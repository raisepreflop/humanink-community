body { font-family: Georgia, serif; font-size: 1em; line-height: 1.5; }
h1 { font-size: 1.6em; text-align: center; margin-top: 3em; margin-bottom: 1em; font-weight: normal; }
h2 { font-size: 1.2em; text-align: center; margin-top: 1.5em; }
p { margin: 0; text-indent: 1.5em; }
h1 + p, h2 + p, .scene-break + p { text-indent: 0; }
.scene-break { text-align: center; margin: 1em 0; text-indent: 0; }
em { font-style: italic; }
strong { font-weight: bold; }
